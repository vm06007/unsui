# Use an absolute path to a separate ledger when enabling mainnet.
# LEDGER_FILE=/absolute/path/to/unsui/server/data/live-ledger.json

# EVM deployment configuration (keys remain server-side).
MULTIBAAS_DEPLOYMENT_URL=
MULTIBAAS_API_KEY=
EVM_DEPLOYER_PRIVATE_KEY=
AWAJI_DEPLOYER_ADDRESS=
AWAJI_ADMIN_ADDRESS=
AWAJI_OPERATOR_ADDRESS=
# Gross rate; contract deducts 2%.
AWAJI_RATE_ATOMIC_PER_JPY=100000000000000
MAX_DEPLOY_FEE_ATOMIC=

# Local demos: resetting permits another real payout from the same card.
ALLOW_LIVE_DEMO_RESET=false
