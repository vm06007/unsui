# USB testing: adb reverse tcp:4100 tcp:4100
WORLD_PUBLIC_BASE_URL=http://localhost:4100
WORLD_ALLOW_LOCAL_HTTP=true
# For hosted use, set an HTTPS origin and disable WORLD_ALLOW_LOCAL_HTTP.

